<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Blender 5.1 Mobile</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body, html { width: 100%; height: 100%; overflow: hidden; background: #222; font-family: sans-serif; color: #fff; }
        
        /* Blender Üst Menü Çubuğu */
        #top-bar {
            position: absolute; top: 0; left: 0; width: 100%; height: 35px;
            background: #2c2c2c; border-bottom: 1px solid #111;
            display: flex; align-items: center; padding: 0 10px; font-size: 12px; z-index: 10;
        }
        .menu-item { margin-right: 15px; color: #ccc; cursor: pointer; }
        .menu-item:hover { color: #fff; }

        /* 3D Görünüm Alanı (Viewport) */
        #canvas-container { width: 100%; height: calc(100% - 135px); margin-top: 35px; position: relative; }

        /* Alt Klavye ve Kısayol Tuşları Bölmesi */
        #keyboard-panel {
            position: absolute; bottom: 0; left: 0; width: 100%; height: 100px;
            background: #1e1e1e; border-top: 2px solid #e76f51;
            display: grid; grid-template-columns: repeat(6, 1fr); gap: 5px; padding: 8px; z-index: 10;
        }
        .blender-key {
            background: #383838; border: 1px solid #555; border-radius: 4px;
            color: #fff; font-size: 13px; font-weight: bold; display: flex;
            align-items: center; justify-content: center; cursor: pointer;
            transition: background 0.1s; user-select: none;
        }
        .blender-key:active { background: #e76f51; color: #fff; }
        .blender-key.active-mod { background: #e76f51; border-color: #f4a261; }
        
        #status-bar {
            position: absolute; bottom: 102px; left: 0; width: 100%; height: 20px;
            background: #181818; font-size: 11px; padding: 0 10px; line-height: 20px; color: #aaa; z-index: 10;
        }
    </style>
    <!-- Three.js 3D Kütüphanesi -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
</head>
<body>

    <!-- Üst Blender Menüsü -->
    <div id="top-bar">
        <div class="menu-item" style="color: #e76f51; font-weight: bold;">Blender 5.1</div>
        <div class="menu-item">File</div>
        <div class="menu-item">Edit</div>
        <div class="menu-item">Render</div>
        <div class="menu-item">Window</div>
        <div class="menu-item">Help</div>
    </div>

    <!-- 3D Sahne Alanı -->
    <div id="canvas-container"></div>

    <!-- Durum Çubuğu -->
    <div id="status-bar">Seçili: Cube | Mod: Nesne Modu | Komut Bekleniyor...</div>

    <!-- Alt Kısayol Tuşları Bölmesi (Mobil İçin) -->
    <div id="keyboard-panel">
        <div class="blender-key" onclick="triggerKey('G')">G (Grab)</div>
        <div class="blender-key" onclick="triggerKey('R')">R (Rotate)</div>
        <div class="blender-key" onclick="triggerKey('S')">S (Scale)</div>
        <div class="blender-key" onclick="triggerKey('Tab')">Tab (Edit)</div>
        <div class="blender-key" id="btn-shift" onclick="toggleMod('Shift')">Shift</div>
        <div class="blender-key" id="btn-ctrl" onclick="toggleMod('Ctrl')">Ctrl</div>
        <div class="blender-key" onclick="triggerKey('X')">X (Sil)</div>
        <div class="blender-key" onclick="triggerKey('A')">A (Tümünü Seç)</div>
        <div class="blender-key" onclick="triggerKey('E')">E (Extrude)</div>
        <div class="blender-key" onclick="triggerKey('I')">I (Insert)</div>
        <div class="blender-key" onclick="triggerKey('Numpad7')">Top (Üst)</div>
        <div class="blender-key" onclick="triggerKey('Numpad1')">Front (Ön)</div>
    </div>

    <script>
        // 1. Sahne ve Kamera Kurulumu
        const container = document.getElementById('canvas-container');
        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x303030); // Blender arayüz gri arka planı

        const camera = new THREE.PerspectiveCamera(60, container.clientWidth / container.clientHeight, 0.1, 1000);
        camera.position.set(4, 4, 5);

        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(container.clientWidth, container.clientHeight);
        container.appendChild(renderer.domElement);

        const controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;

        // 2. Blender Varsayılan Küpü ve Sahne Öğeleri
        const geometry = new THREE.BoxGeometry(1.5, 1.5, 1.5);
        const material = new THREE.MeshStandardMaterial({ color: 0xff7b00, roughness: 0.3 });
        const cube = new THREE.Mesh(geometry, material);
        scene.add(cube);

        const grid = new THREE.GridHelper(10, 10, 0x555555, 0x444444);
        scene.add(grid);

        const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
        scene.add(ambientLight);

        const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
        dirLight.position.set(5, 10, 7);
        scene.add(dirLight);

        // 3. Mobil Tuş İşlevleri
        let shiftActive = false;
        let ctrlActive = false;

        function toggleMod(mod) {
            if (mod === 'Shift') {
                shiftActive = !shiftActive;
                document.getElementById('btn-shift').classList.toggle('active-mod', shiftActive);
            } else if (mod === 'Ctrl') {
                ctrlActive = !ctrlActive;
                document.getElementById('btn-ctrl').classList.toggle('active-mod', ctrlActive);
            }
            updateStatus(mod + " aktif: " + (eval(mod.toLowerCase() + 'Active') ? "AÇIK" : "KAPALI"));
        }

        function triggerKey(key) {
            updateStatus("Kısayol Tuşuna Basıldı: " + key);
            if (key === 'R') {
                cube.rotation.z += 0.5;
            } else if (key === 'S') {
                cube.scale.multiplyScalar(1.1);
            } else if (key === 'G') {
                cube.position.x += 0.2;
            } else if (key === 'X') {
                cube.visible = !cube.visible; // Örneknesne gizle/göster
            } else if (key === 'A') {
                material.color.set(Math.random() * 0xffffff); // Renk değiştirme simülasyonu
            }
        }

        function updateStatus(text) {
            document.getElementById('status-bar').innerText = text;
        }

        // Animasyon Döngüsü
        function animate() {
            requestAnimationFrame(animate);
            controls.update();
            renderer.render(scene, camera);
        }
        animate();

        // Ekran Boyutu Uyarlaması
        window.addEventListener('resize', () => {
            camera.aspect = container.clientWidth / container.clientHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(container.clientWidth, container.clientHeight);
        });
    </script>
</body>
</html>
